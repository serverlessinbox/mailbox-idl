type BearerTokenProvider interface {
	BearerToken(ctx context.Context) (string, error)
}

type StaticBearerToken string

func (t StaticBearerToken) BearerToken(ctx context.Context) (string, error) {
	return string(t), nil
}

type ClientOption func(*clientOptions)
type clientOptions struct {
	httpClient    *http.Client
	tokenProvider BearerTokenProvider
}

func WithHTTPClient(httpClient *http.Client) ClientOption {
	return func(o *clientOptions) { o.httpClient = httpClient }
}

func WithBearerToken(token string) ClientOption {
	return func(o *clientOptions) { o.tokenProvider = StaticBearerToken(token) }
}

func WithBearerTokenProvider(provider BearerTokenProvider) ClientOption {
	return func(o *clientOptions) { o.tokenProvider = provider }
}

func normalizeBaseURL(baseURL string) string {
	return strings.TrimSuffix(baseURL, "/")
}

func kebabCaseServicePath(serviceName string) string {
	name := strings.TrimSuffix(serviceName, "Service")
	var b strings.Builder
	for i, r := range name {
		if unicode.IsUpper(r) {
			if i != 0 {
				b.WriteByte('-')
			}
			b.WriteRune(unicode.ToLower(r))
			continue
		}
		b.WriteRune(r)
	}
	return "/" + b.String()
}

func doProtoJSONCall(ctx context.Context, httpClient *http.Client, tokenProvider BearerTokenProvider, baseURL string, servicePath string, methodName string, req proto.Message, resp proto.Message) error {
	if httpClient == nil {
		httpClient = &http.Client{}
	}
	baseURL = normalizeBaseURL(baseURL)
	url := baseURL + servicePath + "/" + methodName

	body, err := protojson.MarshalOptions{}.Marshal(req)
	if err != nil {
		return fmt.Errorf("marshal request: %w", err)
	}

	httpReq, err := http.NewRequestWithContext(ctx, http.MethodPost, url, bytes.NewReader(body))
	if err != nil {
		return fmt.Errorf("build request: %w", err)
	}
	httpReq.Header.Set("Content-Type", "application/json")
	if tokenProvider != nil {
		token, err := tokenProvider.BearerToken(ctx)
		if err != nil {
			return fmt.Errorf("get bearer token: %w", err)
		}
		if token != "" {
			httpReq.Header.Set("Authorization", "Bearer "+token)
		}
	}

	httpResp, err := httpClient.Do(httpReq)
	if err != nil {
		return fmt.Errorf("do request: %w", err)
	}
	defer httpResp.Body.Close()

	respBody, err := io.ReadAll(httpResp.Body)
	if err != nil {
		return fmt.Errorf("read response: %w", err)
	}

	if httpResp.StatusCode != http.StatusOK {
		return fmt.Errorf("http %s %s failed: status=%d body=%q", servicePath, methodName, httpResp.StatusCode, string(respBody))
	}

	if resp == nil {
		return nil
	}
	if len(respBody) == 0 {
		return nil
	}
	if err := (protojson.UnmarshalOptions{DiscardUnknown: true}).Unmarshal(respBody, resp); err != nil {
		return fmt.Errorf("unmarshal response: %w", err)
	}
	return nil
}
