package jmapsdk

import (
	"context"
	"encoding/json"
	"fmt"
	"reflect"
)

// Batch is a builder for multi-call JMAP requests with result-reference support.
// Use TypedBatch for a strongly-typed wrapper.
type Batch struct {
	using []string
	calls []MethodCall
	seq   int
}

// NewBatch creates an empty batch with the given JMAP capability URIs.
func NewBatch(using ...string) *Batch {
	return &Batch{using: using}
}

// Add appends a method call to the batch and returns the assigned callID
// (e.g. "c0", "c1"). The args value is serialized via marshalArgs, which
// handles result-reference key renaming per RFC 8620 §3.7.
func (b *Batch) Add(method string, args any) (callID string) {
	callID = fmt.Sprintf("c%d", b.seq)
	b.seq++

	raw, err := marshalArgs(args)
	if err != nil {
		// If marshaling fails we store a JSON error marker so Execute surfaces it.
		raw = json.RawMessage(fmt.Sprintf(`{"_marshalError":%q}`, err.Error()))
	}

	b.calls = append(b.calls, MethodCall{
		Name:   method,
		Args:   raw,
		CallID: callID,
	})
	return callID
}

// Request builds the final JMAPRequest ready for Client.Do.
func (b *Batch) Request() *JMAPRequest {
	return &JMAPRequest{
		Using:       b.using,
		MethodCalls: b.calls,
	}
}

// BatchResult holds the raw per-call responses keyed by callID.
// Retrieve typed results via the package-level GetResult function.
type BatchResult struct {
	byCallID map[string]json.RawMessage
}

// Raw returns the raw JSON args for the given callID, or an error if absent.
func (r *BatchResult) Raw(callID string) (json.RawMessage, error) {
	raw, ok := r.byCallID[callID]
	if !ok {
		return nil, fmt.Errorf("jmapsdk: no response for callID %q", callID)
	}
	return raw, nil
}

// GetResult extracts and unmarshals the typed response for the given handle
// from a BatchResult. It is a package-level generic function because Go does
// not support generic methods.
func GetResult[T any](r *BatchResult, h BatchHandle[T]) (*T, error) {
	raw, err := r.Raw(h.callID)
	if err != nil {
		return nil, err
	}
	var result T
	if err := json.Unmarshal(raw, &result); err != nil {
		return nil, fmt.Errorf("jmapsdk: unmarshal result for %q: %w", h.callID, err)
	}
	return &result, nil
}

// BatchHandle carries the callID and the expected response type T.
// T is fixed at compile time — no runtime type assertion is needed.
type BatchHandle[T any] struct {
	callID     string
	methodName string
}

// TypedBatch wraps Batch and exposes one method per JMAP method defined in the
// manifest. It is generated by scripts/generate-go.mjs.
type TypedBatch struct {
	b *Batch
}

// NewTypedBatch creates a new TypedBatch with the given JMAP capability URIs.
func NewTypedBatch(using ...string) *TypedBatch {
	return &TypedBatch{b: NewBatch(using...)}
}

// Execute sends the batch via c and returns a BatchResult.
func (tb *TypedBatch) Execute(ctx context.Context, c Client) (*BatchResult, error) {
	resp, err := c.Do(ctx, tb.b.Request())
	if err != nil {
		return nil, err
	}
	result := &BatchResult{byCallID: make(map[string]json.RawMessage, len(resp.MethodResponses))}
	for _, mc := range resp.MethodResponses {
		result.byCallID[mc.CallID] = mc.Args
	}
	return result, nil
}

// marshalArgs serializes args to JSON, renaming any StringOrRef field whose
// ref is non-nil from "key" to "#key" per RFC 8620 §3.7.
//
// The approach:
//  1. Marshal args normally to get a map[string]json.RawMessage.
//  2. Reflect on the original struct to find StringOrRef fields with a ref set.
//  3. For each such field: delete the plain key, insert "#key" with the
//     ResultRef value.
//  4. Re-marshal the modified map.

func marshalArgs(args any) (json.RawMessage, error) {
	if args == nil {
		return json.RawMessage("null"), nil
	}

	// First pass: normal marshal to get the JSON representation.
	data, err := json.Marshal(args)
	if err != nil {
		return nil, fmt.Errorf("jmapsdk: marshalArgs first pass: %w", err)
	}

	// Unmarshal into a raw map so we can manipulate keys.
	var m map[string]json.RawMessage
	if err := json.Unmarshal(data, &m); err != nil {
		// Not a JSON object (e.g. slice, primitive) — return as-is.
		return data, nil
	}

	// Reflect on the original value to locate StringOrRef fields whose ref is set.
	v := reflect.ValueOf(args)
	for v.Kind() == reflect.Ptr {
		if v.IsNil() {
			return data, nil
		}
		v = v.Elem()
	}
	if v.Kind() != reflect.Struct {
		return data, nil
	}

	stringOrRefType := reflect.TypeOf(StringOrRef{})
	t := v.Type()

	for i := 0; i < t.NumField(); i++ {
		field := t.Field(i)
		if field.Type != stringOrRefType {
			continue
		}
		sor := v.Field(i).Interface().(StringOrRef)
		if !sor.isRef() {
			continue
		}

		// Derive the JSON key name from the struct tag, fallback to lowercase field name.
		jsonKey := field.Tag.Get("json")
		if jsonKey == "" {
			jsonKey = field.Name
		} else {
			// Strip options like ",omitempty".
			for k, c := range jsonKey {
				if c == ',' {
					jsonKey = jsonKey[:k]
					break
				}
			}
		}
		if jsonKey == "" || jsonKey == "-" {
			continue
		}

		// Marshal the ResultRef value.
		refData, err := json.Marshal(sor.ref)
		if err != nil {
			return nil, fmt.Errorf("jmapsdk: marshalArgs ResultRef for %q: %w", jsonKey, err)
		}

		// Rename: delete plain key, insert "#key".
		delete(m, jsonKey)
		m["#"+jsonKey] = refData
	}

	out, err := json.Marshal(m)
	if err != nil {
		return nil, fmt.Errorf("jmapsdk: marshalArgs final marshal: %w", err)
	}
	return out, nil
}
