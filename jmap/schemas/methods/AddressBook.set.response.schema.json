{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/AddressBook.set.response.schema.json",
  "title": "AddressBook/set response",
  "description": "Response from AddressBook/set (RFC 9610 §5.3).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account the changes were applied to." },
    "oldState": { "type": ["string", "null"], "description": "The AddressBook state before this set, or null if the server cannot calculate it." },
    "newState": { "type": "string", "minLength": 1, "description": "The AddressBook state after this set." },
    "created": {
      "type": ["object", "null"],
      "description": "Successfully created address books, keyed by client creation id.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/AddressBook" }
    },
    "updated": {
      "type": ["object", "null"],
      "description": "Map of successfully updated AddressBookId to the updated object (or null if unchanged properties are not returned).",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/AddressBookId" },
      "additionalProperties": { "anyOf": [{ "$ref": "../core/types.schema.json#/$defs/AddressBook" }, { "type": "null" }] }
    },
    "destroyed": {
      "anyOf": [{ "type": "array", "items": { "$ref": "../core/types.schema.json#/$defs/AddressBookId" } }, { "type": "null" }],
      "description": "AddressBookIds that were successfully destroyed."
    },
    "notCreated": {
      "type": ["object", "null"],
      "description": "Creation ids that failed, with a SetError.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    },
    "notUpdated": {
      "type": ["object", "null"],
      "description": "AddressBookIds that failed to update, with a SetError.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/AddressBookId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    },
    "notDestroyed": {
      "type": ["object", "null"],
      "description": "AddressBookIds that failed to destroy, with a SetError.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/AddressBookId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    }
  },
  "required": ["accountId", "newState"],
  "additionalProperties": false
}
