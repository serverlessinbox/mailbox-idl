{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/EmailSubmission.get.response.schema.json",
  "title": "EmailSubmission/get response",
  "description": "Response for EmailSubmission/get (RFC 8621 §7.1 / RFC 8620 §5.1).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account the EmailSubmission objects belong to." },
    "state": { "type": "string", "description": "Current EmailSubmission state, used in subsequent /changes calls." },
    "list": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/EmailSubmission" },
      "description": "The requested EmailSubmission objects."
    },
    "notFound": {
      "type": ["array", "null"],
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" },
      "description": "Ids that were not found."
    }
  },
  "required": ["accountId", "state", "list"],
  "additionalProperties": false
}
