{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/Mailbox.set.response.schema.json",
  "title": "Mailbox/set response",
  "description": "Response from Mailbox/set (RFC 8621 §3.5).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account the changes were applied to." },
    "oldState":  { "type": ["string", "null"], "description": "The Mailbox state before this set, or null if the server cannot calculate it." },
    "newState":  { "type": "string", "minLength": 1, "description": "The Mailbox state after this set." },
    "created": {
      "type": ["object", "null"],
      "description": "Successfully created mailboxes, keyed by client creation id.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/MailboxExt" }
    },
    "updated": {
      "type": ["object", "null"],
      "description": "Map of successfully updated MailboxId to the updated object (or null if unchanged properties are not returned).",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/MailboxId" },
      "additionalProperties": { "anyOf": [{ "$ref": "../core/types.schema.json#/$defs/MailboxExt" }, { "type": "null" }] }
    },
    "destroyed": {
      "anyOf": [{ "type": "array", "items": { "$ref": "../core/types.schema.json#/$defs/MailboxId" } }, { "type": "null" }],
      "description": "MailboxIds that were successfully destroyed."
    },
    "notCreated": {
      "type": ["object", "null"],
      "description": "Creation ids that failed, with a SetError.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    },
    "notUpdated": {
      "type": ["object", "null"],
      "description": "MailboxIds that failed to update, with a SetError.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/MailboxId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    },
    "notDestroyed": {
      "type": ["object", "null"],
      "description": "MailboxIds that failed to destroy, with a SetError.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/MailboxId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    }
  },
  "required": ["accountId", "newState"],
  "additionalProperties": false
}
