{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/Email.set.response.schema.json",
  "title": "Email/set response",
  "$defs": {
    "CreationId": {
      "type": "string",
      "minLength": 1
    },
    "SetError": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "properties": { "type": ["object", "null"], "additionalProperties": true }
      },
      "required": ["type"],
      "additionalProperties": true
    }
  },
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account the changes were applied to." },
    "oldState": { "type": "string", "minLength": 1, "description": "The Email state before this set operation." },
    "newState": { "type": "string", "minLength": 1, "description": "The Email state after this set operation." },

    "created": {
      "type": ["object", "null"],
      "description": "Successfully created emails, keyed by the client-assigned creation id.",
      "propertyNames": { "$ref": "#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/EmailExt" }
    },

    "updated": {
      "type": ["object", "null"],
      "description": "Map of successfully updated EmailId to null or a partial Email object containing only the properties the server changed (RFC 8620 §5.3).",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/EmailId" },
      "additionalProperties": { "anyOf": [{ "$ref": "../core/types.schema.json#/$defs/EmailExt" }, { "type": "null" }] }
    },

    "destroyed": {
      "description": "IDs of successfully destroyed emails, or null if none.",
      "anyOf": [
        { "type": "array", "items": { "$ref": "../core/types.schema.json#/$defs/EmailId" } },
        { "type": "null" }
      ]
    },

    "notCreated": {
      "type": ["object", "null"],
      "description": "Creation ids that failed, with a SetError describing the reason.",
      "propertyNames": { "$ref": "#/$defs/CreationId" },
      "additionalProperties": { "$ref": "#/$defs/SetError" }
    },

    "notUpdated": {
      "type": ["object", "null"],
      "description": "EmailIds that failed to update, with a SetError describing the reason.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/EmailId" },
      "additionalProperties": { "$ref": "#/$defs/SetError" }
    },

    "notDestroyed": {
      "type": ["object", "null"],
      "description": "EmailIds that failed to destroy, with a SetError describing the reason.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/EmailId" },
      "additionalProperties": { "$ref": "#/$defs/SetError" }
    }
  },
  "required": ["accountId", "oldState", "newState"],
  "additionalProperties": false
}
