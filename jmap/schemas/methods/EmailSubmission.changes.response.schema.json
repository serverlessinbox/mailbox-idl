{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/EmailSubmission.changes.response.schema.json",
  "title": "EmailSubmission/changes response",
  "description": "Response for EmailSubmission/changes (RFC 8621 §7.4 / RFC 8620 §5.2).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account these changes are for." },
    "oldState": { "type": "string", "description": "The sinceState value passed in the request." },
    "newState": { "type": "string", "description": "The current EmailSubmission state after these changes." },
    "hasMoreChanges": { "type": "boolean", "description": "If true, more changes exist beyond maxChanges; make another call with newState as sinceState." },
    "created": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" },
      "description": "EmailSubmission ids created since sinceState."
    },
    "updated": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" },
      "description": "EmailSubmission ids updated since sinceState."
    },
    "destroyed": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" },
      "description": "EmailSubmission ids destroyed since sinceState."
    }
  },
  "required": ["accountId", "oldState", "newState", "hasMoreChanges", "created", "updated", "destroyed"],
  "additionalProperties": false
}
