{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/Email.copy.response.schema.json",
  "title": "Email/copy response",
  "description": "Response for Email/copy (RFC 8621 §5.7 / RFC 8620 §5.4).",
  "type": "object",
  "properties": {
    "fromAccountId": { "$ref": "../core/types.schema.json#/$defs/AccountId" },
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId" },
    "oldState": { "type": ["string", "null"] },
    "newState": { "type": "string" },
    "created": {
      "type": ["object", "null"],
      "description": "Map of creation id to created Email object (subset: id, blobId, threadId, size).",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/CreationId" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": { "$ref": "../core/types.schema.json#/$defs/Id" },
          "blobId": { "$ref": "../core/types.schema.json#/$defs/BlobId" },
          "threadId": { "$ref": "../core/types.schema.json#/$defs/Id" },
          "size": { "type": "integer", "minimum": 0 }
        },
        "required": ["id", "blobId", "threadId", "size"],
        "additionalProperties": false
      }
    },
    "notCreated": {
      "type": ["object", "null"],
      "description": "Map of creation id to SetError for failed copies.",
      "propertyNames": { "$ref": "../core/types.schema.json#/$defs/CreationId" },
      "additionalProperties": { "$ref": "../core/types.schema.json#/$defs/SetError" }
    }
  },
  "required": ["fromAccountId", "accountId", "oldState", "newState"],
  "additionalProperties": false
}
