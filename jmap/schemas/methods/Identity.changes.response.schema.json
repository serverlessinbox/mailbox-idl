{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/Identity.changes.response.schema.json",
  "title": "Identity/changes response",
  "description": "Response for Identity/changes (RFC 8621 §6.2 / RFC 8620 §5.2).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId" },
    "oldState": { "type": "string" },
    "newState": { "type": "string" },
    "hasMoreChanges": { "type": "boolean" },
    "created": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" }
    },
    "updated": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" }
    },
    "destroyed": {
      "type": "array",
      "items": { "$ref": "../core/types.schema.json#/$defs/Id" }
    }
  },
  "required": ["accountId", "oldState", "newState", "hasMoreChanges", "created", "updated", "destroyed"],
  "additionalProperties": false
}
