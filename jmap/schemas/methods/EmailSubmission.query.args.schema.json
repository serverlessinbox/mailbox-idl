{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/EmailSubmission.query.args.schema.json",
  "title": "EmailSubmission/query args",
  "description": "Arguments for EmailSubmission/query (RFC 8621 §7.2 / RFC 8620 §5.5).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId" },
    "filter": {
      "type": ["object", "null"],
      "description": "Conditions to filter EmailSubmission objects.",
      "additionalProperties": true
    },
    "sort": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "property": { "type": "string" },
          "isAscending": { "type": "boolean" }
        },
        "required": ["property"],
        "additionalProperties": false
      }
    },
    "position": { "type": ["integer", "null"] },
    "anchor": { "$ref": "../core/types.schema.json#/$defs/Id" },
    "anchorOffset": { "type": ["integer", "null"] },
    "limit": { "type": ["integer", "null"], "minimum": 0 },
    "calculateTotal": { "type": ["boolean", "null"] }
  },
  "required": ["accountId"],
  "additionalProperties": false
}
