{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serverlessinbox.com/schemas/jmap/methods/EmailSubmission.query.args.schema.json",
  "title": "EmailSubmission/query args",
  "description": "Arguments for EmailSubmission/query (RFC 8621 §7.2 / RFC 8620 §5.5).",
  "type": "object",
  "properties": {
    "accountId": { "$ref": "../core/types.schema.json#/$defs/AccountId", "description": "The account to query EmailSubmission objects in." },
    "filter": {
      "type": ["object", "null"],
      "description": "Conditions to filter EmailSubmission objects.",
      "additionalProperties": true
    },
    "sort": {
      "type": ["array", "null"],
      "description": "List of Comparator objects specifying the sort order.",
      "items": {
        "type": "object",
        "properties": {
          "property": { "type": "string" },
          "isAscending": { "type": "boolean" }
        },
        "required": ["property"],
        "additionalProperties": false
      }
    },
    "position": { "type": ["integer", "null"], "description": "Zero-based index of the first result to return." },
    "anchor": { "$ref": "../core/types.schema.json#/$defs/Id", "description": "Id of an item to anchor the result window on." },
    "anchorOffset": { "type": ["integer", "null"], "description": "Offset relative to the anchor." },
    "limit": { "type": ["integer", "null"], "minimum": 0, "description": "Maximum number of ids to return." },
    "calculateTotal": { "type": ["boolean", "null"], "description": "If true, return the total count of results." }
  },
  "required": ["accountId"],
  "additionalProperties": false
}
